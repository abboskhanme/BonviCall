# BonviCall — copy to .env and fill in. NEVER commit .env.

# --- Database ---
POSTGRES_USER=bonvicall
POSTGRES_PASSWORD=change_me
POSTGRES_DB=bonvicall
POSTGRES_TEST_DB=bonvicall_test
DATABASE_URL=postgresql+asyncpg://bonvicall:change_me@postgres:5432/bonvicall
TEST_DATABASE_URL=postgresql+asyncpg://bonvicall:change_me@postgres:5432/bonvicall_test

# --- Auth ---
# openssl rand -hex 32
SECRET_KEY=change_me
# A week (10080 minutes), at the client's request, so nobody is asked to log
# in again during a working week.
#
# Know what it costs before lowering or raising it: an access token is a
# signed JWT and is NOT checked against any store, so it cannot be called
# back. Deactivating a user, or a lost laptop, leaves that token working
# until it expires — for up to a week at this value, for thirty minutes at
# the old one. The refresh cookie below is what a revocation actually stops,
# and it is checked on every rotation.
ACCESS_TOKEN_TTL_MIN=10080
REFRESH_TOKEN_TTL_DAYS=90

# --- First admin (make seed) ---
# Created once, on an empty users table, with must_change_password=true.
# Leave SEED_ADMIN_PASSWORD empty outside production and `make seed` generates
# one and prints it. In production it is REQUIRED: seeding refuses without it,
# because an admin account with a guessable password is a deployment failure
# that nobody notices.
SEED_ADMIN_EMAIL=admin@bonvi.uz
SEED_ADMIN_PASSWORD=Bonvi2026!

# --- Audio storage (core/storage.py, AudioStorage) ---
AUDIO_STORAGE_PATH=/data/audio
AUDIO_RETENTION_MONTHS=12

# --- APK signing (docs/APK-SIGNING.md) ---
# The SHA-256 of the signing certificate, as read from a published APK's v2
# signing block. Set it and an upload signed by any other key is REFUSED; leave
# it empty and such a build is accepted, and the failure surfaces on fifteen
# handsets that cannot install the update. Recovering from that means uninstall
# and reinstall, and an uninstall destroys the calls a phone has not yet sent.
APK_SIGNING_SHA256=

# --- Mobile client version gate (N34) ---
MIN_SUPPORTED_APP_VERSION=1

# --- AI providers (call analysis, SPEC-ANALYTICS §4.2) ---
# The vendor key lives here and NOT in app_settings: that table is served by
# GET /api/v1/settings behind `settings:read`, which a manager holds, so a key
# in it is a key every manager can read.
#
# Leave it empty and nothing breaks: the analysis feature is off by default
# (`analysis.enabled`), and with a blank key the pipeline stops the call with
# `ai_not_configured` rather than guessing. Adding the key needs a container
# restart, which is the cost of keeping it out of the database.
#
# One key, because phase 1 runs both transcription and scoring on Gemini.
AI_GEMINI_API_KEY=

# --- Deployment (docker-compose.prod.yml + infra/Caddyfile) ---
# Only the deployed stack reads these; `make up` ignores them.
#
# The domain must already point at this host before the stack is started:
# Caddy asks Let's Encrypt for a certificate the first time it serves the name,
# and a domain that does not resolve here yet means a failed challenge and a
# wait before the next attempt is allowed.
BONVICALL_DOMAIN=call.bonvi.uz
# Where Let's Encrypt sends expiry warnings if renewal ever stops working.
# REQUIRED: Caddy refuses to parse its config if this is empty, and the error
# it prints is about a missing argument rather than about this line.
BONVICALL_ACME_EMAIL=admin@bonvi.uz
# TEMPORARY, and safe to leave unset. Setting it to the server's public address
# makes the panel reachable at https://<that address> with a self-signed
# certificate, for signing in before DNS has propagated. No handset can use it
# (a release build trusts system CAs only). Remove it once the domain answers.
# BONVICALL_SERVER_IP=203.0.113.10

# --- Server ---
# dev | test | prod. 'prod' switches the log renderer to JSON, hides /docs, and
# makes the server refuse to start while SECRET_KEY or POSTGRES_PASSWORD still
# hold the placeholder above.
ENVIRONMENT=dev
TZ=Asia/Tashkent
LOG_LEVEL=INFO
