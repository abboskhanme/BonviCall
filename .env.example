# BonviCall — copy to .env and fill in. NEVER commit .env.

# --- Database ---
POSTGRES_USER=bonvicall
POSTGRES_PASSWORD=change_me
POSTGRES_DB=bonvicall
POSTGRES_TEST_DB=bonvicall_test
DATABASE_URL=postgresql+asyncpg://bonvicall:change_me@postgres:5432/bonvicall
TEST_DATABASE_URL=postgresql+asyncpg://bonvicall:change_me@postgres:5432/bonvicall_test

# --- Auth ---
# openssl rand -hex 32
SECRET_KEY=change_me
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=90

# --- Audio storage (core/storage.py, AudioStorage) ---
AUDIO_STORAGE_PATH=/data/audio
AUDIO_RETENTION_MONTHS=12

# --- Mobile client version gate (N34) ---
MIN_SUPPORTED_APP_VERSION=1

# --- Server ---
# dev | test | prod. 'prod' switches the log renderer to JSON, hides /docs, and
# makes the server refuse to start while SECRET_KEY or POSTGRES_PASSWORD still
# hold the placeholder above.
ENVIRONMENT=dev
TZ=Asia/Tashkent
LOG_LEVEL=INFO
