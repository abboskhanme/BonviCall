    <!-- ══ E2 ═══════════════════════════════════════════════════════════════
         One screen per permission. Each sentence says PURPOSE AND CONSEQUENCE,
         never the permission's name: the reader is not technical, it is their
         own phone, and Android designed some of these dialogs to look
         alarming. -->
    <string name="perm_phone_state_title">Qo\'ng\'iroqlarni aniqlash</string>
    <string name="perm_phone_state_why">Ilova qo\'ng\'iroq boshlanganini bilishi kerak. Bo\'lmasa hech narsa qayd etilmaydi.</string>

    <string name="perm_call_log_title">Qo\'ng\'iroqlar tarixi</string>
    <string name="perm_call_log_why">Qo\'ng\'iroq tugagach, uning davomiyligi va yo\'nalishi shu yerdan aniqlanadi.</string>

    <string name="perm_notifications_title">Bildirishnomalar</string>
    <string name="perm_notifications_why">Ilova ishlab turganini ko\'rsatuvchi doimiy bildirishnoma uchun. Bildirishnoma o\'chirilsa, telefon ilovani to\'xtatib qo\'yadi.</string>

    <string name="perm_microphone_title">Mikrofon</string>
    <string name="perm_microphone_why">Mikrofon bo\'lmasa suhbat yozilmaydi, lekin qo\'ng\'iroq baribir qayd etiladi.</string>

    <string name="perm_call_phone_title">Qo\'ng\'iroq qilish</string>
    <string name="perm_call_phone_why">Paneldan raqamni bosib qo\'ng\'iroq qilish uchun kerak.</string>

    <string name="perm_contacts_title">Kontaktlar</string>
    <string name="perm_contacts_why">Ro\'yxatda raqam o\'rniga ism ko\'rinishi uchun. Telefon kitobingiz yuborilmaydi — faqat siz gaplashgan odamning ismi o\'sha qo\'ng\'iroq yonida saqlanadi. Bu qadamni o\'tkazib yuborsangiz ham bo\'ladi.</string>

    <string name="perm_battery_title">Batareya cheklovini olib tashlash</string>
    <string name="perm_battery_why">Telefon batareyani tejash uchun ilovani to\'xtatadi va qo\'ng\'iroqlar yozilmay qoladi.</string>

    <string name="perm_storage_title">Yozuvlar papkasi</string>
    <string name="perm_storage_why">Telefonning o\'z diktofoni yozgan faylni topish uchun. Boshqa hech qanday fayl o\'qilmaydi.</string>

    <string name="perm_autostart_title">Avtomatik ishga tushish</string>
    <string name="perm_autostart_why">Telefon o\'chib yonganda ilova o\'zi ishga tushishi kerak.</string>

    <!-- E2 result chips. `granted_not_working` is a distinct state: retrying
         the system dialog will never fix it, so the app must not offer that. -->
    <string name="perm_state_working">Ishlayapti</string>
    <string name="perm_state_not_working">Ruxsat berilgan, lekin ishlamayapti</string>
    <string name="perm_state_not_working_help">Telefon sozlamalaridan ushbu ilova uchun ruxsatni qo\'lda yoqing — bu oynani qayta ochish yordam bermaydi.</string>
    <string name="perm_state_denied">Ruxsat berilmagan</string>
    <string name="perm_state_denied_permanently">Sozlamalardan yoqing</string>
    <string name="perm_state_unknown">Tekshirib bo\'lmadi</string>
    <string name="perm_check_running">Tekshirilmoqda…</string>
    <!-- E2 asks for every runtime permission in ONE request now. Six system
         dialogs still appear, in the same order, but the agent starts them with
         one tap instead of six. The wording promises the sequence so nobody
         thinks the button did nothing when the second dialog opens. -->
    <string name="perm_allow_all">Barcha ruxsatlarni berish</string>
    <string name="perm_recheck">Qayta tekshirish</string>
    <string name="permissions_title">Ruxsatlar</string>
    <string name="permissions_intro">Bu yerda ilova nimaga ruxsat olganini va nimaga olmaganini ko\'rasiz. Ruxsat bermagan bo\'lsangiz, shu yerdan berishingiz mumkin — sozlamadan qaytganingizda ilova o\'zi qayta tekshiradi.</string>
    <string name="permissions_all_good">Hamma kerakli ruxsat berilgan.</string>
    <string name="permissions_recheck">Hammasini qayta tekshirish</string>
    <string name="home_permissions">Ruxsatlar</string>
    <string name="perm_blocking_summary">Yana %1$d ta ruxsat yetishmayapti. Ularsiz qo\'ng\'iroqlar qayd etilmaydi.</string>

    <string name="enrol_permissions_intro">Quyidagi tugmani bosing va telefon ketma-ket so\'raydigan oynalarda «Ruxsat berish»ni tanlang. Har bir ruxsat nima uchun kerakligi pastda yozilgan.</string>

    <!-- E3 — the manufacturer's own screens (R3). Shown only on the OEMs that
         need it. Nothing here can be verified by the platform, so the app never
         records it as granted; the step is guidance, and the screen says so
         rather than pretending a green tick means anything. -->
    <string name="enrol_oem_explain">Telefoningiz ilovani fonda to\'xtatib qo\'yishi mumkin. Quyidagi sozlamalarni yoqsangiz, qo\'ng\'iroqlar tunda ham qayd etiladi.</string>

    <!-- E5's way out, offered even when the callback route works. A proven
         binding is worth more than a declared one, so the challenge is still
         shown first — but a screen whose only exit is "dial this number and
         wait five minutes" is where an unaided install ends. -->
    <string name="enrol_verify_later">Keyinroq tasdiqlash — hozir davom etish</string>
    <string name="enrol_verify_awaiting_admin">Administrator raqamingizni tasdiqlashini kutmoqda. Bu oynani yopmang — tasdiqlangach, o\'zi davom etadi.</string>

