    <string name="audio_queued">Yozuv yuborilmoqda</string>
    <string name="audio_not_expected">Suhbat bo\'lmagan — yozuv kutilmaydi</string>
    <string name="calls_offline">Internetga ulanib bo\'lmadi. Ro\'yxatni ko\'rish uchun aloqa kerak.</string>
