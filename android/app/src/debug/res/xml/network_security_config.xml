<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY. This file is in `src/debug/` and is not part of any release
  artefact — `assembleRelease` never sees it.

  N22 and CONVENTIONS-CLIENT.md §9 say cleartext is disabled and certificate
  errors are never bypassed. This narrows that rule rather than lifting it:

    • the BASE config still refuses cleartext, so an accidental http:// call to
      anything not named below still fails;
    • cleartext is permitted to NAMED HOSTS ONLY — the emulator's loopback and
      one LAN address for a developer testing on a real handset;
    • no <trust-anchors> entry for user-installed certificates anywhere, in any
      build type. That is the part that actually matters: a phone with a
      corporate or malware root must not be able to read the audio of every
      call the fleet makes, and a debug build that trusts user CAs is how a
      developer's proxy becomes a habit.

  `cleartextTrafficPermitted="true"` on <base-config> is forbidden and
  ManifestPermissionsTest fails the build if it appears here.

  10.0.2.2 is the host machine as seen from the Android emulator.
  192.168.1.10 is a placeholder LAN address: change it locally, do not add a
  wildcard, and do not add a second domain without a reason in the diff.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">192.168.1.10</domain>
    </domain-config>
</network-security-config>
