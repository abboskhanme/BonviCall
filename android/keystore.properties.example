# Copy to keystore.properties (gitignored) on the machine that cuts releases.
# ⚠️ NEVER commit the real file or the .jks it points at.
# The environment variables below are the CI equivalents and take second place.
#
#   storeFile        BONVICALL_KEYSTORE          path, relative to android/
#   storePassword    BONVICALL_KEYSTORE_PASSWORD
#   keyAlias         BONVICALL_KEY_ALIAS         defaults to "bonvicall"
#   keyPassword      BONVICALL_KEY_PASSWORD
#
# Without any of them `assembleRelease` still succeeds and produces
# `-unsigned.apk`, so CI and a developer without the key are never blocked.

storeFile=bonvicall-release.jks
storePassword=CHANGE_ME
keyAlias=bonvicall
keyPassword=CHANGE_ME

# Testing on a real handset over the LAN (debug builds only). Set this to the
# address of the machine running `make up`, e.g. 192.168.1.23, and rebuild the
# debug APK. See docs/ON-DEVICE-TESTING.md.
# bonvicall.devHost=192.168.1.23
